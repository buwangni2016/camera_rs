name: Build Android APK

on:
  workflow_dispatch:
  push:
    branches: [ main ]
    paths:
      - 'android/**'
      - '.github/workflows/build-android.yml'

jobs:
  build-apk:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Setup Gradle (no wrapper needed)
        uses: gradle/actions/setup-gradle@v4

      - name: Build debug APK
        working-directory: android
        run: gradle assembleDebug --no-daemon

      - name: Rename APK
        run: |
          cp android/app/build/outputs/apk/debug/app-debug.apk camera_rs-android-debug.apk

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: camera_rs-android-debug
          path: camera_rs-android-debug.apk

      - name: Attach to latest release
        run: |
          gh release upload latest camera_rs-android-debug.apk --clobber --repo buwangni2016/camera_rs || \
          gh release create latest camera_rs-android-debug.apk --title "camera_rs latest" --notes "自动构建产物" --repo buwangni2016/camera_rs
        env:
          GH_TOKEN: ${{ github.token }}
